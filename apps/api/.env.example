# Postgres from the root docker-compose.yml (port 5433). Tests always use TEST_DATABASE_URL.
DATABASE_URL=postgresql://rahasya:rahasya@localhost:5433/rahasya
TEST_DATABASE_URL=postgresql://rahasya:rahasya@localhost:5433/rahasya_test

# Generate each with: openssl rand -base64 32
JWT_SECRET=
# Encrypts TOTP secrets at rest (AES-256-GCM); must decode to exactly 32 bytes.
DATA_KEY=

# Comma-separated web origins allowed to call the API (Expo web dev server, deployed web app).
CORS_ORIGINS=http://localhost:8081
PORT=3000

# Admin console (A1–A5): WebAuthn relying party and the console's origin.
ADMIN_RP_ID=localhost
ADMIN_ORIGIN=http://localhost:3001
# Comma-separated IPs and CIDR ranges allowed to reach /admin, or * for any (local dev only). Unset blocks everyone.
ADMIN_IP_ALLOWLIST=*

# Emergency recovery (Option B): the organisation's offline X25519 public key, base64. Unset turns opt-in off.
RECOVERY_PUBLIC_KEY=
# Waiting period after an admin confirms a recovery, 0 to 168 hours (default 48).
RECOVERY_WAIT_HOURS=48
